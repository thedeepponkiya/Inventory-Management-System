# Copy this file to .env on the server and fill in real values. Never commit the real .env.

PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=ims_db

# 32-byte hex key used to encrypt the stored Meta (Facebook/Instagram) Page Access Token -
# generate one with: openssl rand -hex 32
META_TOKEN_ENCRYPTION_KEY=
