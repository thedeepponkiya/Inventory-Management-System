# Copy to /etc/nginx/sites-available/ims, symlink into sites-enabled, then run:
#   sudo certbot --nginx -d ims.evasoftek.com
# (certbot rewrites this file in place to add the HTTPS server block + redirect).
server {
    listen 80;
    server_name ims.evasoftek.com;

    # Built frontend (frontend/dist after `npm run build`).
    root /path/to/Inventory-Manufacturing-Management/frontend/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Backend API - matches apiConfig.ts's relative /api/v1 base URL.
    location /api/ {
        proxy_pass http://localhost:5000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploaded product images (backend/uploads/products) - matches resolveImageUrl's
    # relative /uploads path in commonFunction.ts.
    location /uploads/ {
        proxy_pass http://localhost:5000/uploads/;
    }
}
