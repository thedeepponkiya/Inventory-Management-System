# Node modules
node_modules/
dist/
build/

# Environment files
.env

# Logs
*.log

# Uploaded product images (backend/uploads/products) - keep the folder structure tracked
# via .gitkeep, but not the actual uploaded files.
backend/uploads/products/*
!backend/uploads/products/.gitkeep

# pg_dump backups from the Database Update admin action (backend/src/utils/databaseBackup.util.js)
# - keep the folder tracked via .gitkeep, never the actual dump files (can contain live data).
backend/backups/*
!backend/backups/.gitkeep